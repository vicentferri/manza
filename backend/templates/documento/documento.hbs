<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>{{nombreFichero}}</title>
<style>
  @page { size: A4 landscape; margin: 10mm 10mm; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: Arial, Helvetica, sans-serif; font-size: 8pt; color: #000; }
  .hoja { break-after: page; page-break-after: always; }
  .hoja.ultima { break-after: auto; page-break-after: auto; }
  .fecha-impresion { font-size: 8pt; margin: 0 0 4mm; }
  h1 { font-size: 11.5pt; font-weight: bold; margin: 0 0 6mm; }
  table { width: 100%; border-collapse: collapse; }
  th, td { border: 1px solid #a6a6a6; text-align: center; vertical-align: middle; padding: 1mm 1.5mm; }
  th { background: #ececec; font-weight: bold; height: 11mm; font-size: 7.5pt; }
  td { height: 13.5mm; }
  td.producto { text-align: left; }
  td.importe { text-align: right; white-space: nowrap; }
  td.c1 { white-space: nowrap; }
  tr { break-inside: avoid; page-break-inside: avoid; }
  tr.total td { font-weight: bold; height: 10mm; }
  tr.total td.etiqueta { text-align: right; }
  /* Resumen de precios al final del documento */
  .resumen { width: 55%; margin: 6mm 0 0 auto; break-inside: avoid; page-break-inside: avoid; }
  .resumen td { height: 8mm; text-align: left; }
  .resumen td.c1, .resumen td.importe { text-align: right; width: 22%; }
  .resumen tr.total td { font-weight: bold; font-size: 9.5pt; background: #ececec; border-top: 2px solid #000; border-bottom: 2px solid #000; }
</style>
</head>
<body>
  {{#each hojas}}
  <div class="hoja{{#if ultima}} ultima{{/if}}">
    <p class="fecha-impresion">Fecha: {{../fechaImpresion}}</p>
    <h1>{{../textoDocumento}}: {{../referencia}} - {{../textoFecha}}: {{../fecha}} - Fecha prevista: {{../fechaPrevista}}</h1>
    <table>
      <thead>
        <tr>
          {{#each columnas}}<th>{{titulo}}</th>{{/each}}
        </tr>
      </thead>
      <tbody>
        {{#each filas}}
        <tr>
          {{#each this}}<td class="{{clase}}">{{valor}}</td>{{/each}}
        </tr>
        {{/each}}
        {{#if total}}
        <tr class="total">
          <td class="etiqueta" colspan="{{total.colspan}}">{{total.etiqueta}}</td>
          <td class="c1">{{total.c1}}</td>
          <td class="importe">{{total.precio}}</td>
        </tr>
        {{/if}}
      </tbody>
    </table>
    {{#if resumen}}
    <table class="resumen">
      <thead>
        <tr><th>Resumen</th><th>C1</th><th>Importe</th></tr>
      </thead>
      <tbody>
        {{#each resumen}}
        <tr class="{{clase}}">
          <td>{{etiqueta}}</td>
          <td class="c1">{{c1}}</td>
          <td class="importe">{{precio}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
    {{/if}}
  </div>
  {{/each}}
</body>
</html>
