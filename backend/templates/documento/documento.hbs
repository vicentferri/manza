<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<title>{{nombreFichero}}</title>
<style>
  /* Los márgenes van en las opciones del PDF: la cabecera y el pie de cada hoja se pintan dentro de ellos */
  @page { size: A4 landscape; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: Arial, Helvetica, sans-serif; font-size: 8pt; color: #000; }
  /* Los bloques van seguidos; solo se pasa de hoja cuando no cabe la siguiente fila */
  .seccion { margin-bottom: 5mm; }
  h2 { font-size: 9.5pt; font-weight: bold; margin: 0 0 2mm; break-after: avoid; page-break-after: avoid; }
  table { width: 100%; border-collapse: collapse; }
  /* thead se repite en la hoja siguiente si la tabla no cabe */
  thead { display: table-header-group; }
  th, td { border: 1px solid #a6a6a6; text-align: center; vertical-align: middle; padding: 1mm 1.5mm; }
  th { background: #ececec; font-weight: bold; height: 9mm; font-size: 7.5pt; }
  td { height: 10mm; }
  td.producto { text-align: left; }
  td.importe { text-align: right; white-space: nowrap; }
  td.c1 { white-space: nowrap; }
  tr { break-inside: avoid; page-break-inside: avoid; }
  tr.total td { font-weight: bold; height: 8mm; }
  tr.total td.etiqueta { text-align: right; }
  /* Resumen de precios al final del documento */
  .resumen { width: 55%; margin: 2mm 0 0 auto; break-inside: avoid; page-break-inside: avoid; }
  .resumen td { height: 7mm; text-align: left; }
  .resumen td.c1, .resumen td.importe { text-align: right; width: 22%; }
  .resumen tr.total td { font-weight: bold; font-size: 9.5pt; background: #ececec; border-top: 2px solid #000; border-bottom: 2px solid #000; }
</style>
</head>
<body>
  {{#each secciones}}
  <div class="seccion">
    <h2>{{titulo}}</h2>
    <table>
      <thead>
        <tr>
          {{#each columnas}}<th>{{titulo}}</th>{{/each}}
        </tr>
      </thead>
      <tbody>
        {{#each filas}}
        <tr>
          {{#each this}}<td class="{{clase}}">{{valor}}</td>{{/each}}
        </tr>
        {{/each}}
        {{#if total}}
        <tr class="total">
          <td class="etiqueta" colspan="{{total.colspan}}">{{total.etiqueta}}</td>
          <td class="c1">{{total.c1}}</td>
          <td class="importe">{{total.precio}}</td>
        </tr>
        {{/if}}
      </tbody>
    </table>
  </div>
  {{/each}}

  <table class="resumen">
    <thead>
      <tr><th>Resumen</th><th>C1</th><th>Importe</th></tr>
    </thead>
    <tbody>
      {{#each resumen}}
      <tr class="{{clase}}">
        <td>{{etiqueta}}</td>
        <td class="c1">{{c1}}</td>
        <td class="importe">{{precio}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>
</body>
</html>
